pipeline {
    agent any

    environment {
        AWS_REGION      = 'ap-south-1'
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_NAME      = 'product-service'
        IMAGE_TAG       = "${BUILD_NUMBER}"
        CLUSTER_NAME    = 'flipkart-cluster'
        K8S_NAMESPACE   = 'flipkart'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────
        stage('Checkout') {
        // ─────────────────────────────────────────────
            steps {
                checkout scm
                echo "Building commit: ${env.GIT_COMMIT?.take(7)}"
            }
        }

        // ─────────────────────────────────────────────
        stage('Build & Test') {
        // ─────────────────────────────────────────────
            steps {
                dir('backend') {
                    sh '''
                        mvn -pl product-service -am clean verify \
                            -Dspring.profiles.active=test \
                            -Dmaven.test.failure.ignore=false
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'backend/product-service/target/surefire-reports/*.xml'
                }
            }
        }

        // ─────────────────────────────────────────────
        stage('Package JAR') {
        // ─────────────────────────────────────────────
            steps {
                dir('backend') {
                    sh 'mvn -pl product-service -am package -DskipTests'
                }
            }
        }

        // ─────────────────────────────────────────────
        stage('Docker Build') {
        // ─────────────────────────────────────────────
            steps {
                dir('backend/product-service') {
                    sh """
                        docker build \
                          -t ${IMAGE_NAME}:${IMAGE_TAG} \
                          -t ${IMAGE_NAME}:latest \
                          .
                    """
                }
            }
        }

        // ─────────────────────────────────────────────
        stage('Push to AWS ECR') {
        // ─────────────────────────────────────────────
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} \
                          | docker login --username AWS --password-stdin ${ECR_REGISTRY}

                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_REGISTRY}/${IMAGE_NAME}:latest

                        docker push ${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${ECR_REGISTRY}/${IMAGE_NAME}:latest
                    """
                }
            }
        }

        // ─────────────────────────────────────────────
        stage('Determine Blue/Green Slot') {
        // ─────────────────────────────────────────────
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    script {
                        sh "aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}"

                        def active = sh(
                            script: "kubectl get svc product-service -n ${K8S_NAMESPACE} -o jsonpath='{.spec.selector.version}' 2>/dev/null || echo blue",
                            returnStdout: true
                        ).trim()

                        env.ACTIVE_SLOT   = active
                        env.INACTIVE_SLOT = (active == 'blue') ? 'green' : 'blue'
                        echo "Active: ${env.ACTIVE_SLOT} → Deploying to: ${env.INACTIVE_SLOT}"
                    }
                }
            }
        }

        // ─────────────────────────────────────────────
        stage('Deploy to EKS (inactive slot)') {
        // ─────────────────────────────────────────────
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        kubectl set image deployment/product-service-${INACTIVE_SLOT} \
                          product-service=${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}

                        kubectl rollout status deployment/product-service-${INACTIVE_SLOT} \
                          -n ${K8S_NAMESPACE} --timeout=120s
                    """
                }
            }
        }

        // ─────────────────────────────────────────────
        stage('Smoke Test') {
        // ─────────────────────────────────────────────
            steps {
                sh """
                    kubectl run smoke-${BUILD_NUMBER} --rm -i --restart=Never \
                      --image=curlimages/curl:latest -n ${K8S_NAMESPACE} -- \
                      curl -sf http://product-service-${INACTIVE_SLOT}:8081/actuator/health
                """
            }
        }

        // ─────────────────────────────────────────────
        stage('Switch Traffic (Blue-Green Cutover)') {
        // ─────────────────────────────────────────────
            steps {
                input message: "Switch traffic from ${ACTIVE_SLOT} → ${INACTIVE_SLOT}?",
                      ok: 'Yes, cut over'

                sh """
                    kubectl patch svc product-service -n ${K8S_NAMESPACE} \
                      -p '{"spec":{"selector":{"version":"${INACTIVE_SLOT}"}}}'

                    echo "✅ Traffic now on: ${INACTIVE_SLOT}"
                    kubectl get svc product-service -n ${K8S_NAMESPACE} \
                      -o jsonpath='{.spec.selector}'
                """
            }
        }
    }

    post {
        success {
            echo "✅ Build #${BUILD_NUMBER} deployed to ${env.INACTIVE_SLOT} slot successfully"
        }
        failure {
            echo "❌ Build #${BUILD_NUMBER} failed — ${env.ACTIVE_SLOT} slot still serving traffic"
        }
        always {
            cleanWs()
        }
    }
}
